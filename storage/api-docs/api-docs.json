                ],
                "summary": "Supprimer un client OAuth2",
                "description": "Supprimer un client OAuth2. Route générée par Passport.",
                "operationId": "20309bdd897c31ea5efcbf8b37352352",
                "parameters": [
                    {
                        "name": "client_id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Client supprimé"
                    }
                },
                "security": [
                    {
                        "passport": []
                    }
                ]
            }
        },
        "/oauth/scopes": {
            "get": {
                "tags": [
                    "OAuth2"
                ],
                "summary": "Lister les scopes OAuth2",
                "description": "Récupérer la liste des scopes OAuth2 disponibles. Route générée par Passport.",
                "operationId": "8fb2ff58e5deb2170711e1902d035654",
                "responses": {
                    "200": {
                        "description": "Liste des scopes",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
